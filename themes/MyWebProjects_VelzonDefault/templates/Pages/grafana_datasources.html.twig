{% extends 'base.html.twig' %}

{# Override Blocs #}
{% block title %}{{ parent() }} :: Grafana Datasources{% endblock %}
{% block pageTitle %}
    <h4 class="pageheader-title">
        <i class="fas fa-bell"></i> 
        Grafana Datasources
    </h4>
{% endblock %}

{% block content %}
	<!-- Begin Page Content -->
	<div class="container-fluid">
		<!-- Page Heading -->
        <div class="row" style="margin: 0 0 30px 0">
            <div class="col-10">
                <div class="btn-group" role="group" aria-label="Basic example">
                    <a class="btn btn-primary"
                        title="Open Grafana" 
                        href="{{ grafanaUrl }}"
                        target="_blank"
                    >
                        Open Grafana
                    </a>&nbsp;
                    
                    <a class="btn btn-primary"
                        title="Open Alertmanager" 
                        href="{{ alertmanagerUrl }}"
                        target="_blank"
                    >
                        Open Alertmanager
                    </a>&nbsp;
                    
                    <button id="btnCreateDatasource" type="button" class="btn btn-primary"
                        data-url="{{ path( 'application-monitoring-grafana-datasource_form', {'id': 0} ) }}"
                    >
                        Create Datasource
                    </button>&nbsp;
                    
                    <button id="btnCreateDatasourceExporter" type="button" class="btn btn-primary"
                        data-url="{{ path( 'application-monitoring-grafana-datasource_exporter_form', {'datasourceId': 0, 'id': 0} ) }}"
                    >
                        Create Exporter
                    </a>&nbsp;
                    
                    <div class="btn-space"></div>
                </div>
            </div>
        </div>
        
        <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                {% for datasource in grafanaDatasources %}
                    <div class="card">
                        <div class="card-header">
                            <div class="float-start" style="height:30px; padding-top:10px;">{{ datasource.name }}</div>
                            <div class="btn-group float-end">
                                {% if datasource.link %}
                                    <a class="btn btn-primary"
                                        title="Open" 
                                        href="{{ datasource.link }}"
                                        target="_blank"
                                    >
                                        Open
                                    </a>&nbsp;
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="card-body">
                            <table class="table table-striped table-advance table-hover">
                                <thead>
                                    <tr>
                                        <th style="font-weight: bold;">Name</th>
                                        <th style="font-weight: bold;">Description</th>
                                        <th style="text-align:center; font-weight: bold;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for exporter in datasource.exporters %}
                                        <tr>
                                            <td>{{ exporter.name }}</td>
                                            <td>{{ exporter.description }}</td>
                                            <td width="100">
                                                <a href="{{ exporter.link }}" target="__blank" class="btn btn-success btn-circle btn-sm btnOpen" title="Open">
                                                    <i class="fas fa-file-export"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div> 
	</div>
	<!-- /.container-fluid -->
{% endblock %}

{% block modals %}
	{{ parent() }}
	
  	<!-- Create Project Modal-->
	{% include 'Modals/grafana_datasource_edit.html.twig' %}
	{% include 'Modals/grafana_datasource_exporter_edit.html.twig' %}
{% endblock %}

{% block head_styles %}
    {{ parent() }}
    
    {{ encore_entry_link_tags( 'js/pages/grafana_datasources', null, 'MyWebProjects_VelzonDefault' ) }}
{% endblock %}

{% block body_scripts %}
	{{ parent() }}
	
    {{ encore_entry_script_tags( 'js/pages/grafana_datasources', null, 'MyWebProjects_VelzonDefault' ) }}
{% endblock %}

